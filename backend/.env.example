PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/todo_app
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# OAuth 2.0 "Web application" client ID from Google Cloud Console — used to verify
# Google ID tokens sent by the mobile app. Must match the webClientId configured in
# mobile/src/auth/googleSignIn.ts.
GOOGLE_WEB_CLIENT_ID=

# Gemini API key (https://aistudio.google.com/apikey) — powers the voice "add task"
# flow's speech-transcript-to-structured-task parsing. Never sent to the mobile app;
# all Gemini calls happen server-side (see src/services/geminiTaskParser.ts).
GEMINI_API_KEY=
